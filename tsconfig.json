{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "coach-sync-worker",
    "src/domain/competition/tests/competitionResultDomainParity.test.ts",
    "src/domain/competition/tests/parentResultsRecorded.test.ts",
    "src/domain/competition/tests/parentResultsRecordedGateWiring.test.ts",
    "src/features/coach/tests/coachDashboardPullToRefreshWiring.test.ts",
    "src/features/coach/tests/ux002CoachVoiceReuseWiring.test.ts"
  ]
}
