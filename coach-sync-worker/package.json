{
  "name": "matmind-coach-sync-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --experimental-strip-types --test src/sharedMatchMediaUpload.test.ts src/matchMediaPublication.test.ts src/uploadMultipartPartWithSha256.test.ts src/productionVerification/*.test.ts",
    "test:canary": "node --experimental-strip-types --test src/productionVerification/canaryControl.test.ts",
    "test:digest-smoke": "node --experimental-strip-types --test src/productionVerification/digestStream.smoke.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.productionVerification.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260714.1",
    "@types/node": "22.13.10",
    "typescript": "5.9.3",
    "wrangler": "4.112.0"
  }
}
