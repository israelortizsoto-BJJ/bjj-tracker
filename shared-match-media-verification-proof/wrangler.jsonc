{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matmind-shared-media-verification-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PROOF_ENABLED": "0",
    "PROOF_HARNESS_VERSION": "verification-runtime-proof-v1"
  },
  "r2_buckets": [
    {
      "binding": "PROOF_MEDIA",
      "bucket_name": "matmind-shared-media-verification-proof"
    }
  ],
  "workflows": [
    {
      "binding": "VERIFICATION_PROOF",
      "name": "matmind-shared-media-verification-proof-workflow",
      "class_name": "VerificationProofWorkflow"
    }
  ]
}
